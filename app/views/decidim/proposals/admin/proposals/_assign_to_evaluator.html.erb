<%= append_javascript_pack_tag "decidim_reporting_proposals", defer: true %>
<%= append_stylesheet_pack_tag "decidim_proposals", media: "all" %>
<% if allowed_to?(:assign_to_evaluator, :proposals, proposal:) %>
  <div id="js-assign-proposal-to-evaluator-actions" class="js-bulk-action-form form-single-proposal" style="max-width:400px; display:block">
    <%= form_tag(evaluation_assignment_path, method: :post, id: "js-form-assign-proposal-to-evaluator", class: "form form-defaults") do %>
      <div class="form__wrapper">
        <div class="card">
          <div class="flex items-center">
            <div class="checkboxes hide">
              <%= check_box_tag "proposal_ids[]", proposal.id, true, class: "js-check-all-proposal js-proposal-id-#{proposal.id}" %>
            </div>

            <select
              id="assign_evaluator_role_ids"
              name="evaluator_role_ids[]"
              placeholder="<%= t("decidim.proposals.admin.proposals.index.select_evaluators") %>"
              class="w-full mt-2 js-evaluator-multiselect"
              multiple>
              <%= available_evaluators_for_proposal(proposal, current_user).map do |option| %>
                <option value="<%= option[1] %>"><%= option[0] %></option>
              <% end %>
            </select>

            <%= submit_tag(t("decidim.proposals.admin.proposals.index.assign_to_evaluator_button"), id: "js-submit-assign-proposal-to-evaluator", class: "button button__sm button__secondary ml-2") %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
