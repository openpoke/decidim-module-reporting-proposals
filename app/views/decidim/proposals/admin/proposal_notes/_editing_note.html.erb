<% if proposal_note.author == current_user %>
  <%= cell("decidim/reporting_proposals/edit_note_modal", proposal_note, modal_id: "editNoteModal#{proposal_note.id}", note: proposal_note, proposal: proposal) %>
  <button type="button" class="link-alt m-xs text-gray cursor-pointer"
          data-dialog-open="editNoteModal<%= proposal_note.id %>"
          title="<%= t("modal.title", scope: "decidim.reporting_proposals.admin.proposal_notes") %>"
          aria-controls="editNoteModal<%= proposal_note.id %>"
          aria-haspopup="true"
          tabindex="0">
    <%= icon "pencil-line", aria_hidden: true, class: "action-icon--preview", role: "img", "aria-hidden": true %>
  </button>
<% end %>
<% if proposal_note.created_at != proposal_note.updated_at %>
  <span class="text-muted">
    <%= t("update.edited", scope: "decidim.reporting_proposals.admin.proposal_notes") %>
    <%= l proposal_note.updated_at, format: :short %>
  </span>
<% end %>
