<%= decidim_form_for(@photo_form, url: decidim_admin_reporting_proposals.add_photos_path(id: proposal.id),
                     method: :post,
                     html: { multipart: true, class: "form edit_proposal proposal_form_admin" }) do |f| %>
  <div class="row column gallery__container">
    <fieldset>
      <div class="row column mb-2">
        <%= f.upload :add_attachments, multiple: true, button_class: "button button__sm button__transparent-secondary" %>
      </div>
      <div class="actions">
        <%= f.submit t(".action"), class: "button button__sm button__secondary" %>
      </div>
    </fieldset>
  </div>
<% end %>
